---
/*
 * Type runs the Haas-substitute system stack (see global.css).
 * Peralta is loaded for card names only — game flavor
 * against the calm editorial body.
 */
import "@fontsource/peralta/400.css";
import "../styles/global.css";
import pkg from "../../package.json";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
}

// Swap at launch — single constant feeds canonical + OG URLs site-wide.
const SITE = "https://anime-draft.example";
const BACKDROP_OG =
  "https://res.cloudinary.com/nn2w9isf/image/upload/f_auto,q_auto/v1/anime-draft/ancient_bg?_a=BAMAROFG0";

const {
  title = "Anime Draft — Free One Piece Minigames",
  description = "Anime Draft is a free One Piece minigame hub. Draft your own pirate from 184 characters, rank the strongest, and play more games.",
  canonicalPath = "/",
  ogImage = BACKDROP_OG,
} = Astro.props;
const canonical = `${SITE}${canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <link href={canonical} rel="canonical" />
    <meta content="#181d26" name="theme-color" />
    <meta content="website" property="og:type" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonical} property="og:url" />
    <meta content={ogImage} property="og:image" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={ogImage} name="twitter:image" />
  </head>
  <body>
    <slot />
    <footer class="w-full bg-surface-dark">
      <div
        class="mx-auto flex w-full max-w-5xl flex-col items-center justify-between gap-2 px-6 py-6 text-[11px] tracking-wide text-on-dark/60 sm:flex-row"
      >
        <span>Anime Draft · v{pkg.version}</span>
        <span>Unofficial fan project. One Piece © Eiichiro Oda / Shueisha.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
