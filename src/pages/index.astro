---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.svelte";

// Brand hub: franchise-neutral. Sells anime minigames, routes to franchises.
// Lore FAQ moved to /one-piece — this page keeps brand questions only.
const faqs = [
  {
    q: "What is Anime Draft?",
    a: "A free anime minigame hub. Play quick browser games — no download, no account — starting with the One Piece draft game. Naruto games are next.",
  },
  {
    q: "Is it really free?",
    a: "Yes — every game is free forever. No accounts, no paywalls. Your progress lives in the browser.",
  },
  {
    q: "Which anime are coming next?",
    a: "Naruto games are on the map after One Piece. One hub, many crews — same draft-and-rank formula, new worlds.",
  },
];
---

<Layout
  canonicalPath="/"
  description="Anime Draft — free anime minigames in your browser. Play the One Piece draft game, rank pirates, and watch for Naruto games next."
  title="Anime Draft — Free Anime Minigames"
>
  <NavBar showRestart={false} />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Anime Draft?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A free anime minigame hub. Play quick browser games with no download and no account, starting with the One Piece draft game."
          }
        },
        {
          "@type": "Question",
          "name": "Is it really free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — every game is free forever. No accounts, no paywalls."
          }
        },
        {
          "@type": "Question",
          "name": "Which anime are coming next?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Naruto games are on the map after One Piece."
          }
        }
      ]
    }
  </script>

  <div class="bg-paper text-cocoa">
    <main class="mx-auto w-full max-w-5xl px-6">
      <!-- Hero: banner pill, Peralta H1, sticker button. -->
      <section class="py-14 text-center md:py-20">
        <p
          class="inline-block -rotate-2 rounded-lg border-[3px] border-coral bg-white px-4 py-1 text-sm font-bold tracking-[0.2em] text-coral uppercase"
        >
          ★ Free anime minigames ★
        </p>
        <h1 class="mx-auto mt-6 max-w-2xl font-hand text-6xl leading-[1.05]">Anime Draft</h1>
        <p class="mx-auto mt-4 max-w-xl text-lg">
          Quick anime games in yer browser — draft pirates today, ninjas tomorrow. No download, no account, five
          minutes a game.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            class="rounded-2xl border-4 border-cocoa bg-coral px-8 py-4 text-xl font-bold text-white shadow-[6px_6px_0_#3a2a18] active:translate-x-1 active:translate-y-1 active:shadow-none"
            href="/one-piece"
          >
            ⚓ Play One Piece games
          </a>
          <a
            class="rounded-2xl border-4 border-cocoa bg-white px-8 py-4 text-xl font-bold text-cocoa shadow-[6px_6px_0_#3a2a18] active:translate-x-1 active:translate-y-1 active:shadow-none"
            href="/one-piece/draft#play"
          >
            Jump to the draft
          </a>
        </div>
      </section>

      <!-- Franchise cards: One Piece live, Naruto soon. -->
      <section class="mb-12">
        <h2 class="text-center font-hand text-4xl">Pick yer world</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <div
            class="rotate-[-0.5deg] rounded-3xl border-4 border-cocoa bg-forest p-8 text-white shadow-[8px_8px_0_#3a2a18]"
          >
            <p class="text-xs font-bold tracking-[0.16px] text-white/60 uppercase">Live now</p>
            <h3 class="mt-2 font-hand text-4xl">One Piece</h3>
            <p class="mt-2 text-sm">Draft game · rankings · Straw Hats · haki answers.</p>
            <a
              class="mt-5 inline-block rounded-2xl border-4 border-cocoa bg-yellow px-6 py-3 font-bold text-cocoa shadow-[6px_6px_0_#3a2a18] active:translate-x-1 active:translate-y-1 active:shadow-none"
              href="/one-piece"
            >
              Set sail →
            </a>
          </div>
          <div class="rotate-[0.5deg] rounded-3xl border-4 border-cocoa/40 bg-white p-8 opacity-70">
            <p class="text-xs font-bold tracking-[0.16px] text-cocoa/50 uppercase">Soon</p>
            <h3 class="mt-2 font-hand text-4xl">Naruto</h3>
            <p class="mt-2 text-sm">Draft yer shinobi. Jutsu, tailed beasts, live ranks.</p>
          </div>
        </div>
      </section>

      <!-- Brand FAQ. -->
      <section class="mx-auto mb-16 max-w-3xl">
        <h2 class="text-center font-hand text-4xl">Fair questions</h2>
        <div class="mt-6 flex flex-col gap-4">
          {
            faqs.map((f) => (
              <details class="rounded-2xl border-[3px] border-cocoa bg-white px-5 py-4 shadow-[4px_4px_0_#3a2a18]">
                <summary class="cursor-pointer text-lg font-bold">{f.q}</summary>
                <p class="mt-2 leading-relaxed text-cocoa/80">{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</Layout>
