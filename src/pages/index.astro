---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.svelte";
import { Characters } from "../data/characters-v2";
import { calculateCharacterBST } from "../lib/draft";

// Hub landing: brand + game cards + rankings teaser + FAQ.
// All equity flows to /games/draft via exact-anchor CTAs.
const ranked = [...Characters]
  .map((c) => ({ name: c.displayName, rarity: c.rarity, bst: calculateCharacterBST(c) }))
  .sort((a, b) => b.bst - a.bst);
const top5 = ranked.slice(0, 5);

const faqs = [
  {
    q: "Does Blackbeard have Conqueror's Haki?",
    a: "Never demonstrated in the manga or anime, and unconfirmed on his Vivre Card — he fights Yonko-tier on two Devil Fruits and elite Armament instead. Try drafting his Yami Yami no Mi in the draft game and see how far fruit power alone takes a build.",
  },
  {
    q: "Does Garp have Conqueror's Haki?",
    a: "Yes — confirmed, and our data rates it among the strongest in the series. Garp is one of the best Conqueror's donors you can pull in round 4.",
  },
  {
    q: "What is Imu's Devil Fruit?",
    a: "Still unnamed in canon — a grimoire-like power granting covenants, regeneration and abyss summons. In our 184-character rankings Imu sits #1 at 11,392 BST, 21 points above Joy Boy.",
  },
  {
    q: "Who would win, Imu or Joy Boy?",
    a: "By our feat-graded stat model: Imu, by 21 BST. Joy Boy's Nika Mythical Zoan keeps it the closest matchup at the top of the list — see the full rankings.",
  },
  {
    q: "Does Zoro have Conqueror's Haki?",
    a: "Yes — advanced Conqueror's, unlocked against King in Wano. Zoro is a premium round-4 donor and a top weapon pull with Enma-class blades.",
  },
];
---

<Layout
  canonicalPath="/"
  description="Anime Draft is a free One Piece minigame hub. Play the One Piece draft game — build your own pirate from 184 characters — plus rankings and character guides."
  title="Anime Draft — Free One Piece Minigames"
>
  <NavBar showRestart={false} />

  <main class="mx-auto w-full max-w-5xl px-6">
    <!-- Hero: white canvas, H1 carries brand + minigames terms. -->
    <section class="py-16 text-center md:py-24">
      <p class="text-xs font-medium tracking-[0.16px] text-ink/60 uppercase">Free One Piece minigames</p>
      <h1 class="mt-3 font-display text-4xl leading-[1.1] font-normal text-ink md:text-5xl">Anime Draft</h1>
      <p class="mx-auto mt-4 max-w-xl text-base text-ink/70">
        Draft your own pirate from 184 One Piece characters — harvest haki, Devil Fruits and weapons round by
        round, then rank your custom build against the full roster.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a
          class="rounded-xl bg-ink px-6 py-4 text-base font-medium text-white active:bg-black"
          href="/games/draft"
        >
          Play the One Piece draft game
        </a>
        <a
          class="rounded-xl border border-hairline bg-white px-6 py-4 text-base font-medium text-ink"
          href="/games/draft/how-to-play"
        >
          How to play
        </a>
      </div>
    </section>

    <!-- Game card: dark signature surface, exact-anchor CTA home to the game. -->
    <section class="mb-16 rounded-xl bg-surface-dark p-8 md:p-12">
      <p class="text-xs font-medium tracking-[0.16px] text-on-dark/60 uppercase">Featured minigame</p>
      <h2 class="mt-2 font-display text-3xl leading-[1.2] font-normal text-on-dark">One Piece Draft Game</h2>
      <p class="mt-3 max-w-2xl text-sm text-on-dark/70">
        Eight rounds. Four donors per round. Body, three haki types, Devil Fruit, weapon, intelligence, battle IQ —
        then a live rank out of 185. Two rerolls per draft, 184 canon-graded donors, zero accounts.
      </p>
      <a
        class="mt-6 inline-block rounded-xl bg-mustard px-6 py-4 text-base font-medium text-ink active:bg-yellow"
        href="/games/draft"
      >
        Start drafting
      </a>
    </section>

    <!-- Rankings teaser: top 5, links to the full P2 magnet page. -->
    <section class="mb-16">
      <div class="mb-4 flex items-baseline justify-between">
        <h2 class="font-display text-2xl font-normal text-ink md:text-3xl">Strongest right now</h2>
        <a class="text-sm font-medium text-blue-700" href="/games/draft/rankings"> Full 184-character rankings </a>
      </div>
      <ol class="overflow-hidden rounded-xl border border-hairline">
        {
          top5.map((c, i) => (
            <li class="flex items-center justify-between border-b border-hairline px-4 py-3 last:border-b-0">
              <span class="text-sm text-ink">
                <span class="mr-3 text-ink/50">#{i + 1}</span>
                {c.name}
              </span>
              <span class="text-sm text-ink/60">
                {c.rarity} · {c.bst.toLocaleString()}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- FAQ: P3 long-tails, equity stays on-page (no outbound links). -->
    <section class="mb-16 max-w-3xl">
      <h2 class="mb-4 font-display text-2xl font-normal text-ink md:text-3xl">One Piece powers, answered</h2>
      <div class="flex flex-col gap-3">
        {
          faqs.map((f) => (
            <details class="rounded-xl border border-hairline bg-white px-5 py-4">
              <summary class="cursor-pointer text-base font-medium text-ink">{f.q}</summary>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- Secondary links: spokes of the hub. -->
    <section class="mb-16 flex flex-wrap gap-3">
      <a
        class="rounded-full border border-hairline px-4 py-2 text-sm font-medium text-ink"
        href="/games/draft/how-to-play"
      >
        How to play
      </a>
      <a
        class="rounded-full border border-hairline px-4 py-2 text-sm font-medium text-ink"
        href="/games/draft/rankings"
      >
        Character rankings
      </a>
      <a
        class="rounded-full border border-hairline px-4 py-2 text-sm font-medium text-ink"
        href="/games/draft/characters"
      >
        Straw Hat guides
      </a>
    </section>
  </main>
</Layout>
