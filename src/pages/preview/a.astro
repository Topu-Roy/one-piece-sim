---
import Layout from "../../layouts/Layout.astro";
import "@fontsource/fredoka/400.css";
import "@fontsource/fredoka/500.css";
import "@fontsource/fredoka/600.css";
import "@fontsource/fredoka/700.css";
import { Characters } from "../../games/one-piece-draft/data/characters-v2";
import { calculateCharacterBST } from "../../games/one-piece-draft/lib/draft";

// STYLE A — "Wanted Poster": parchment, thick ink outlines, hard sticker
// shadows, tilted badges. Peralta headings + Fredoka rounded body.

// Card showroom: strongest face on the roster fronts every variant.
const top1 = [...Characters]
  .map((c) => ({ name: c.displayName, imageURL: c.imageURL, bst: calculateCharacterBST(c) }))
  .sort((a, b) => b.bst - a.bst)[0];
---

<Layout canonicalPath="/preview/a" description="Style preview A" noindex title="Style A — Wanted Poster">
  <style>
    .font-playful {
      font-family: "Fredoka", ui-rounded, system-ui, sans-serif;
    }
  </style>
  <div class="min-h-screen bg-[#f5e9d4] font-playful text-cocoa">
    <nav class="border-b-4 border-cocoa">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-4">
        <a class="font-hand text-3xl text-cocoa" href="/preview/a">Anime Draft</a>
        <span
          class="rotate-2 rounded-lg border-[3px] border-cocoa bg-yellow px-3 py-1 text-xs font-bold tracking-widest uppercase"
        >
          Style A
        </span>
      </div>
    </nav>

    <main class="mx-auto w-full max-w-5xl px-6">
      <section class="py-14 text-center">
        <p
          class="inline-block -rotate-2 rounded-lg border-[3px] border-coral bg-white px-4 py-1 text-sm font-bold tracking-[0.2em] text-coral uppercase"
        >
          ★ Wanted ★ Dead or alive ★
        </p>
        <h1 class="mx-auto mt-6 max-w-2xl font-hand text-6xl leading-[1.05] text-cocoa">Draft yer own pirate!</h1>
        <p class="mx-auto mt-4 max-w-xl text-lg">
          Pick yer body, haki, Devil Fruit ’n weapon across 8 rounds — then see how yer scallywag ranks against all
          184 sea dogs!
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            class="rounded-2xl border-4 border-cocoa bg-coral px-8 py-4 text-xl font-bold text-white shadow-[6px_6px_0_#3a2a18] active:translate-x-1 active:translate-y-1 active:shadow-none"
            href="/one-piece/draft#play"
          >
            ⚓ Start draftin'!
          </a>
          <a
            class="rounded-2xl border-4 border-cocoa bg-white px-8 py-4 text-xl font-bold shadow-[6px_6px_0_#3a2a18] active:translate-x-1 active:translate-y-1 active:shadow-none"
            href="/one-piece/draft/how-to-play"
          >
            Read the map
          </a>
        </div>
      </section>

      <section
        class="mb-12 rotate-[-0.5deg] rounded-3xl border-4 border-cocoa bg-forest p-8 text-white shadow-[8px_8px_0_#3a2a18] md:p-10"
      >
        <div class="flex items-center gap-3">
          <span class="rounded-full bg-yellow px-3 py-1 text-xs font-bold tracking-widest text-cocoa uppercase">
            Bounty · 3,000,000,000
          </span>
        </div>
        <h2 class="mt-3 font-hand text-4xl">One Piece Draft Game</h2>
        <p class="mt-2 max-w-2xl">
          Eight rounds of plunderin’! Four scallywags per round — body, three haki, Devil Fruit, weapon, brains ’n
          battle smarts. Two rerolls, no take-backs!
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="rounded-lg border-2 border-white/40 px-3 py-1 text-sm">🏴‍☠️ 184 donors</span>
          <span class="rounded-lg border-2 border-white/40 px-3 py-1 text-sm">🎲 2 rerolls</span>
          <span class="rounded-lg border-2 border-white/40 px-3 py-1 text-sm">👑 Live rank</span>
        </div>
        <a
          class="mt-6 inline-block rounded-2xl border-4 border-cocoa bg-yellow px-8 py-3 text-lg font-bold text-cocoa"
          href="/one-piece/draft#play"
        >
          Set sail →
        </a>
      </section>

      <section class="mx-auto mb-16 max-w-3xl">
        <h2 class="text-center font-hand text-4xl">Wanted sideways — pick W1–W4</h2>
        <p class="mt-2 text-center">All four link to the draft game. Winner goes on /one-piece.</p>

        <div class="mt-8 grid gap-8 md:grid-cols-2">
          <!-- W1: masthead top — WANTED banner, sideways row below. -->
          <div>
            <p class="mb-2 text-center text-sm font-bold tracking-[0.2em] uppercase">W1 · Masthead top</p>
            <a
              class="block rotate-[0.5deg] rounded-3xl border-4 border-cocoa bg-white p-4 text-center shadow-[8px_8px_0_#3a2a18]"
              href="/one-piece/draft"
            >
              <p class="font-hand text-3xl tracking-[0.12em] text-cocoa">WANTED</p>
              <p class="text-xs font-bold tracking-[0.3em] text-cocoa/60 uppercase">Dead or alive</p>
              <div class="mt-3 flex items-stretch gap-4 text-left">
                <div class="relative w-2/5 shrink-0 overflow-hidden rounded-2xl border-[3px] border-cocoa">
                  <img
                    alt={top1.name}
                    class="absolute inset-0 h-full w-full object-cover object-top"
                    loading="lazy"
                    src={top1.imageURL}
                  />
                </div>
                <div class="flex min-w-0 flex-col justify-center py-1">
                  <h3 class="font-hand text-2xl leading-[1.05] text-cocoa">Create the Strongest Character</h3>
                  <span
                    class="mt-3 inline-block w-fit rounded-2xl border-[3px] border-cocoa bg-coral px-6 py-2 text-base font-bold text-white shadow-[4px_4px_0_#3a2a18]"
                  >
                    Play →
                  </span>
                </div>
              </div>
            </a>
          </div>

          <!-- W2: masthead in column — small WANTED opens the type stack. -->
          <div>
            <p class="mb-2 text-center text-sm font-bold tracking-[0.2em] uppercase">W2 · Masthead in column</p>
            <a
              class="flex rotate-[-0.5deg] items-stretch gap-4 rounded-3xl border-4 border-cocoa bg-white p-4 shadow-[8px_8px_0_#3a2a18]"
              href="/one-piece/draft"
            >
              <div class="relative w-2/5 shrink-0 overflow-hidden rounded-2xl border-[3px] border-cocoa">
                <img
                  alt={top1.name}
                  class="absolute inset-0 h-full w-full object-cover object-top"
                  loading="lazy"
                  src={top1.imageURL}
                />
              </div>
              <div class="flex min-w-0 flex-col justify-center py-1">
                <p class="font-hand text-2xl tracking-[0.12em] text-cocoa">WANTED</p>
                <p class="text-[11px] font-bold tracking-[0.3em] text-cocoa/60 uppercase">Dead or alive</p>
                <h3 class="mt-2 font-hand text-2xl leading-[1.05] text-cocoa">Create the Strongest Character</h3>
                <p class="mt-1 text-sm text-cocoa/70">Draft 8 powers onto one pirate.</p>
                <span
                  class="mt-3 inline-block w-fit rounded-2xl border-[3px] border-cocoa bg-yellow px-6 py-2 text-base font-bold text-cocoa shadow-[4px_4px_0_#3a2a18]"
                >
                  Play →
                </span>
              </div>
            </a>
          </div>

          <!-- W3: stamp overlap — big WANTED stamp crashes over the art. -->
          <div>
            <p class="mb-2 text-center text-sm font-bold tracking-[0.2em] uppercase">W3 · Stamp overlap</p>
            <a
              class="flex rotate-[0.5deg] items-stretch gap-4 rounded-3xl border-4 border-cocoa bg-white p-4 shadow-[8px_8px_0_#3a2a18]"
              href="/one-piece/draft"
            >
              <div class="relative w-2/5 shrink-0 overflow-hidden rounded-2xl border-[3px] border-cocoa">
                <img
                  alt={top1.name}
                  class="absolute inset-0 h-full w-full object-cover object-top"
                  loading="lazy"
                  src={top1.imageURL}
                />
                <p
                  class="absolute top-2 -right-2 rotate-12 rounded-lg border-[3px] border-cocoa bg-coral px-3 py-1 font-hand text-lg tracking-[0.1em] text-white"
                >
                  WANTED
                </p>
              </div>
              <div class="flex min-w-0 flex-col justify-center py-1">
                <p class="text-[11px] font-bold tracking-[0.3em] text-cocoa/60 uppercase">Dead or alive</p>
                <h3 class="mt-1 font-hand text-2xl leading-[1.05] text-cocoa">Create the Strongest Character</h3>
                <span
                  class="mt-3 inline-block w-fit rounded-2xl border-[3px] border-cocoa bg-coral px-6 py-2 text-base font-bold text-white shadow-[4px_4px_0_#3a2a18]"
                >
                  Play →
                </span>
              </div>
            </a>
          </div>

          <!-- W4: bounty column — WANTED, title, bounty pill, full-width coral. -->
          <div>
            <p class="mb-2 text-center text-sm font-bold tracking-[0.2em] uppercase">W4 · Bounty column</p>
            <a
              class="flex rotate-[-0.5deg] items-stretch gap-4 rounded-3xl border-4 border-cocoa bg-white p-4 shadow-[8px_8px_0_#3a2a18]"
              href="/one-piece/draft"
            >
              <div class="relative w-2/5 shrink-0 overflow-hidden rounded-2xl border-[3px] border-cocoa">
                <img
                  alt={top1.name}
                  class="absolute inset-0 h-full w-full object-cover object-top"
                  loading="lazy"
                  src={top1.imageURL}
                />
              </div>
              <div class="flex min-w-0 flex-1 flex-col justify-center py-1">
                <p class="font-hand text-2xl tracking-[0.12em] text-cocoa">WANTED</p>
                <p class="text-[11px] font-bold tracking-[0.3em] text-cocoa/60 uppercase">Dead or alive</p>
                <h3 class="mt-2 font-hand text-2xl leading-[1.05] text-cocoa">Create the Strongest Character</h3>
                <p
                  class="mt-2 w-fit -rotate-1 rounded-lg border-[3px] border-cocoa bg-yellow px-3 py-1 text-xs font-bold tracking-[0.2em] text-cocoa uppercase"
                >
                  ★ Free to play ★
                </p>
                <span
                  class="mt-3 block rounded-2xl border-[3px] border-cocoa bg-coral px-6 py-2 text-center text-base font-bold text-white shadow-[4px_4px_0_#3a2a18]"
                >
                  Play →
                </span>
              </div>
            </a>
          </div>
        </div>
      </section>

      <section class="mx-auto mb-16 max-w-3xl">
        <h2 class="text-center font-hand text-4xl">Tavern talk</h2>
        <div class="mt-6 flex flex-col gap-4">
          <details class="rounded-2xl border-[3px] border-cocoa bg-white px-5 py-4 shadow-[4px_4px_0_#3a2a18]">
            <summary class="cursor-pointer text-lg font-bold">Does Blackbeard have Conqueror's Haki?</summary>
            <p class="mt-2">
              Never shown! He brawls Yonko-tier on two Devil Fruits alone. Draft his Yami Yami no Mi 'n find out!
            </p>
          </details>
          <details class="rounded-2xl border-[3px] border-cocoa bg-white px-5 py-4 shadow-[4px_4px_0_#3a2a18]">
            <summary class="cursor-pointer text-lg font-bold">Who's strongest — Imu or Joy Boy?</summary>
            <p class="mt-2">Our ledger says Imu! Joy Boy's Nika keeps it closer than a barnacle, though.</p>
          </details>
        </div>
      </section>
    </main>

    <footer class="border-t-4 border-cocoa py-6 text-center text-sm">
      Style A preview · not indexed · <a class="underline" href="/">back to hub</a>
    </footer>
  </div>
</Layout>
