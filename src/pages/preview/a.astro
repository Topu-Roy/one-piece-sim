---
import Layout from "../../layouts/Layout.astro";
import "@fontsource/fredoka/400.css";
import "@fontsource/fredoka/500.css";
import "@fontsource/fredoka/600.css";
import "@fontsource/fredoka/700.css";

// STYLE A — "Wanted Poster": parchment, thick ink outlines, hard sticker
// shadows, tilted badges. Peralta headings + Fredoka rounded body.
---

<Layout canonicalPath="/preview/a" description="Style preview A" noindex title="Style A — Wanted Poster">
  <style>
    .font-playful {
      font-family: "Fredoka", ui-rounded, system-ui, sans-serif;
    }
  </style>
  <div class="font-playful min-h-screen bg-[#f5e9d4] text-[#3a2a18]">
    <nav class="border-b-4 border-[#3a2a18]">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-4">
        <a class="font-hand text-3xl text-[#3a2a18]" href="/preview/a">Anime Draft</a>
        <span
          class="rotate-2 rounded-lg border-[3px] border-[#3a2a18] bg-[#f4d35e] px-3 py-1 text-xs font-bold tracking-widest uppercase"
        >
          Style A
        </span>
      </div>
    </nav>

    <main class="mx-auto w-full max-w-5xl px-6">
      <section class="py-14 text-center">
        <p
          class="inline-block -rotate-2 rounded-lg border-[3px] border-[#aa2d00] bg-white px-4 py-1 text-sm font-bold tracking-[0.2em] text-[#aa2d00] uppercase"
        >
          ★ Wanted ★ Dead or alive ★
        </p>
        <h1 class="mx-auto mt-6 max-w-2xl font-hand text-6xl leading-[1.05] text-[#3a2a18]">
          Draft yer own pirate!
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-lg">
          Pick yer body, haki, Devil Fruit ’n weapon across 8 rounds — then see how yer scallywag ranks against all
          184 sea dogs!
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            class="rounded-2xl border-4 border-[#3a2a18] bg-[#aa2d00] px-8 py-4 text-xl font-bold text-white shadow-[6px_6px_0_#3a2a18] active:translate-x-1 active:translate-y-1 active:shadow-none"
            href="/games/draft"
          >
            ⚓ Start draftin’!
          </a>
          <a
            class="rounded-2xl border-4 border-[#3a2a18] bg-white px-8 py-4 text-xl font-bold shadow-[6px_6px_0_#3a2a18] active:translate-x-1 active:translate-y-1 active:shadow-none"
            href="/games/draft/how-to-play"
          >
            Read the map
          </a>
        </div>
      </section>

      <section
        class="mb-12 rotate-[-0.5deg] rounded-3xl border-4 border-[#3a2a18] bg-[#0a2e0e] p-8 text-white shadow-[8px_8px_0_#3a2a18] md:p-10"
      >
        <div class="flex items-center gap-3">
          <span
            class="rounded-full bg-[#f4d35e] px-3 py-1 text-xs font-bold tracking-widest text-[#3a2a18] uppercase"
          >
            Bounty · 3,000,000,000
          </span>
        </div>
        <h2 class="mt-3 font-hand text-4xl">One Piece Draft Game</h2>
        <p class="mt-2 max-w-2xl">
          Eight rounds of plunderin’! Four scallywags per round — body, three haki, Devil Fruit, weapon, brains ’n
          battle smarts. Two rerolls, no take-backs!
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="rounded-lg border-2 border-white/40 px-3 py-1 text-sm">🏴‍☠️ 184 donors</span>
          <span class="rounded-lg border-2 border-white/40 px-3 py-1 text-sm">🎲 2 rerolls</span>
          <span class="rounded-lg border-2 border-white/40 px-3 py-1 text-sm">👑 Live rank</span>
        </div>
        <a
          class="mt-6 inline-block rounded-2xl border-4 border-[#3a2a18] bg-[#f4d35e] px-8 py-3 text-lg font-bold text-[#3a2a18]"
          href="/games/draft"
        >
          Set sail →
        </a>
      </section>

      <section class="mx-auto mb-16 max-w-3xl">
        <h2 class="text-center font-hand text-4xl">Tavern talk</h2>
        <div class="mt-6 flex flex-col gap-4">
          <details class="rounded-2xl border-[3px] border-[#3a2a18] bg-white px-5 py-4 shadow-[4px_4px_0_#3a2a18]">
            <summary class="cursor-pointer text-lg font-bold">Does Blackbeard have Conqueror's Haki?</summary>
            <p class="mt-2">
              Never shown! He brawls Yonko-tier on two Devil Fruits alone. Draft his Yami Yami no Mi ’n find out!
            </p>
          </details>
          <details class="rounded-2xl border-[3px] border-[#3a2a18] bg-white px-5 py-4 shadow-[4px_4px_0_#3a2a18]">
            <summary class="cursor-pointer text-lg font-bold">Who's strongest — Imu or Joy Boy?</summary>
            <p class="mt-2">
              Our ledger says Imu, by 21 points! Joy Boy's Nika keeps it closer than a barnacle, though.
            </p>
          </details>
        </div>
      </section>
    </main>

    <footer class="border-t-4 border-[#3a2a18] py-6 text-center text-sm">
      Style A preview · not indexed · <a class="underline" href="/">back to hub</a>
    </footer>
  </div>
</Layout>
