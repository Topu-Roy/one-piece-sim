---
import Layout from "../../../layouts/Layout.astro";
import DraftGame from "../../../games/one-piece-draft/components/DraftGame.svelte";
---

<Layout
  canonicalPath="/one-piece/draft/play"
  description="Play the free One Piece draft game: 8 rounds, 184 characters, live rank."
  title="Play — One Piece Draft Game | Anime Draft"
>
  <DraftGame client:only="svelte" />

  <!-- Compact SEO footer supporting the play query. -->
  <div class="bg-paper text-cocoa">
    <main class="mx-auto w-full max-w-3xl px-6 pb-12">
      <h1 class="sr-only">Play the One Piece draft game</h1>
      <h2 class="font-hand text-3xl">About this game</h2>
      <p class="mt-2 leading-relaxed text-cocoa/80">
        The One Piece draft game deals 8 rounds of 4 canon-graded donors — body, three haki types, Devil Fruit,
        weapon, intelligence and battle IQ — then ranks your custom build against all 184 roster characters. Two
        rerolls per draft, free forever.
      </p>
      <div class="mt-4 flex flex-wrap gap-3 text-sm font-bold">
        <a class="text-coral underline" href="/one-piece/draft">Game home</a>
        <a class="text-coral underline" href="/one-piece/draft/how-to-play">How to play</a>
        <a class="text-coral underline" href="/one-piece/draft/rankings">Rankings</a>
      </div>
    </main>
  </div>
</Layout>
