---
import Layout from "../../../layouts/Layout.astro";
import NavBar from "../../../components/NavBar.svelte";
import { Characters } from "../../../games/one-piece-draft/data/characters-v2";
import { calculateCharacterBST, weaponLabel } from "../../../games/one-piece-draft/lib/draft";

// All-characters hub: 10 graded Straw Hat guides + every donor grouped by
// tier (god → basic = strongest first). Card grids carry image + name only.
const guides = [
  {
    id: "monkey-d-luffy",
    blurb:
      "Captain. Gear 5 Nika — a Mythical Zoan — plus supreme Armament and Conqueror's with advanced Observation. The highest-ranked Straw Hat in our model.",
    qa: {
      q: "What is Luffy's Devil Fruit called?",
      a: "The Human-Human Fruit, Model: Nika — a Mythical Zoan the World Government renamed the Gum-Gum Fruit to hide. It grants the Gear 5 Sun God form.",
    },
  },
  {
    id: "roronoa-zoro",
    blurb:
      "First mate. No Devil Fruit — pure swordsmanship with advanced Armament and advanced Conqueror's coating through Enma. The crew's best weapon donor.",
    qa: {
      q: "Does Zoro have Conqueror's Haki?",
      a: "Yes — advanced Conqueror's, unlocked against King in Wano and coated through his blades. Our data grades it advanced tier.",
    },
  },
  {
    id: "nami",
    blurb:
      "Navigator. No Devil Fruit and no haki — Nami fights with the Sorcery Clima-Tact staff and Zeus's thunder. Proof a build doesn't need haki to matter.",
    qa: {
      q: "Does Nami have a Devil Fruit?",
      a: "No. Her weather eggs, mirages and Zeus thundercloud come from technology and a stolen soul-homie — no fruit, no haki, all tactics.",
    },
  },
  {
    id: "usopp",
    blurb:
      "Sniper. No Devil Fruit, but basic Observation Haki awakened in Dressrosa, paired with the Kabuto slingshot and Pop Green ammo.",
    qa: {
      q: "Does Usopp have Haki?",
      a: "Yes — Observation, awakened sensing Sugar's aura across Dressrosa. It's basic tier in our data, but it makes him a legit round-3 donor.",
    },
  },
  {
    id: "sanji",
    blurb:
      "Cook. No Devil Fruit — advanced Armament and advanced Observation with Ifrit Jambe flames and exoskeleton durability. The crew's fastest fighter.",
    qa: {
      q: "Does Sanji have a Devil Fruit?",
      a: "No — he famously refused even the Invisible Fruit on principle. His power is pure body: flames, speed, and advanced haki on both sides.",
    },
  },
  {
    id: "tony-tony-chopper",
    blurb:
      "Doctor. The Human-Human Fruit (standard Zoan) with no haki — Monster Point transformations carry his combat weight entirely through the fruit.",
    qa: {
      q: "What is Chopper's Devil Fruit?",
      a: "The Human-Human Fruit — it turned a reindeer human-like and, with Rumble Balls, unlocks forms up to Monster Point.",
    },
  },
  {
    id: "nico-robin",
    blurb:
      "Archaeologist. The Flower-Flower Fruit (Paramecia) with no haki — Demonio Fleur giant limbs scale purely off fruit mastery and anatomy knowledge.",
    qa: {
      q: "What is Robin's Devil Fruit?",
      a: "The Flower-Flower Fruit — sprout any body part on any surface. Wano's Demonio Fleur showed its top-end grappling power.",
    },
  },
  {
    id: "franky",
    blurb:
      "Shipwright. No Devil Fruit and no haki — a self-made cyborg wielding the General Franky arsenal. The crew's technology answer to powers.",
    qa: {
      q: "Does Franky have a Devil Fruit?",
      a: "No. Every ability is cola-powered cybernetics he built himself — lasers, rockets, and the General Franky mecha.",
    },
  },
  {
    id: "brook",
    blurb:
      "Musician. The Revive-Revive Fruit (Paramecia) with no haki — soul chill through the Soul Solid sword plus unmatched speed make him lethal anyway.",
    qa: {
      q: "What is Brook's Devil Fruit?",
      a: "The Revive-Revive Fruit — one extra life plus soul projection and freezing soul energy channeled through his blade.",
    },
  },
  {
    id: "jinbe",
    blurb:
      "Helmsman. No Devil Fruit and no weapon — basic Armament and Observation behind Fish-Man Karate shockwaves that hit through armor and water alike.",
    qa: {
      q: "Does Jinbe have Haki?",
      a: "Yes — basic Armament and Observation, layered over Fish-Man Karate mastery. A former Warlord with fundamentals most pirates lack.",
    },
  },
];

const hakiLine = (id: string) => {
  const c = Characters.find((x) => x.id === id)!;
  const parts = [
    `Armament ${c.haki.armament.tier}`,
    `Observation ${c.haki.observation.tier}`,
    `Conqueror's ${c.haki.conqueror.tier}`,
  ];
  return parts.join(" · ");
};

const fruitLine = (id: string) => {
  const c = Characters.find((x) => x.id === id)!;
  return c.devilFruit.type === "none" ? "No Devil Fruit" : `${c.devilFruit.englishName} (${c.devilFruit.type})`;
};

const weaponOf = (id: string) => {
  const c = Characters.find((x) => x.id === id)!;
  return c.weapon.type === "none" ? "Unarmed" : weaponLabel(c);
};

const tiers = [
  {
    key: "god",
    title: "God tier",
    blurb:
      "The canon apex — eight monsters above the rest. Imu, Joy Boy, Rocks, Luffy, Shanks, Roger, Dragon and Whitebeard. Pull one in any round and the draft bends around you.",
  },
  {
    key: "legend",
    title: "Legend tier",
    blurb:
      "Yonko commanders, Admirals, Warlords and Gorosei — the strongest mortals in the setting. Legend donors win more drafts than gods, simply because you actually draw them.",
  },
  {
    key: "epic",
    title: "Epic tier",
    blurb:
      "Top officers, Warlord crews and New World veterans. Epic is the workhorse tier — solid haki, real fruits, honest weapons in nearly every round.",
  },
  {
    key: "basic",
    title: "Basic tier",
    blurb:
      "East Blue rookies, comic relief and lovable weaklings. Basics rarely carry a round — but a basic body with god donors still wins drafts.",
  },
] as const;

const byTier = (rarity: string) =>
  [...Characters]
    .filter((c) => c.rarity === rarity)
    .map((c) => ({ id: c.id, name: c.displayName, imageURL: c.imageURL, bst: calculateCharacterBST(c) }))
    .sort((a, b) => b.bst - a.bst);
---

<Layout
  canonicalPath="/one-piece/draft/characters"
  description="Every One Piece character in the draft game, grouped god to basic: Straw Hat powers graded, all 184 donors with haki, Devil Fruits and weapons."
  title="One Piece Characters — All 184 by Tier, Powers & Ranks"
>
  <NavBar showRestart={false} />

  <div class="bg-paper text-cocoa">
    <main class="mx-auto w-full max-w-5xl px-6 py-12 md:py-16">
      <p class="text-xs font-bold tracking-[0.16px] text-cocoa/60 uppercase">
        <a class="text-coral underline" href="/one-piece/draft">One Piece draft game</a> · Characters
      </p>
      <h1 class="mt-2 font-hand text-5xl leading-[1.05]">One Piece characters</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed">
        All 184 draftable characters, grouped strongest-first: god, legend, epic, basic. Straw Hat powers graded
        stat by stat below — then the full roster, every one of them draftable:
        <a class="font-bold text-coral underline" href="/one-piece/draft#play">play the draft game</a>.
      </p>

      <h2 class="mt-12 mb-4 font-hand text-4xl">Straw Hats</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {
          guides.map((g) => {
            const c = Characters.find((x) => x.id === g.id)!;
            return (
              <section
                class="overflow-hidden rounded-2xl border-[3px] border-cocoa bg-white shadow-[4px_4px_0_#3a2a18]"
                id={g.id}
              >
                <div class="flex gap-4 p-5">
                  {c.imageURL && (
                    <img
                      alt={c.displayName}
                      class="h-20 w-20 shrink-0 rounded-full border-[3px] border-cocoa object-cover"
                      loading="lazy"
                      src={c.imageURL}
                    />
                  )}
                  <div class="min-w-0">
                    <h3 class="font-hand text-3xl">{c.displayName}</h3>
                    <p class="mt-0.5 text-sm font-bold text-coral uppercase">{c.rarity}</p>
                    <p class="mt-2 leading-relaxed text-cocoa/80">{g.blurb}</p>
                  </div>
                </div>
                <dl class="border-t-[3px] border-t-cocoa bg-white px-5 py-3 text-sm">
                  <div class="flex gap-2 py-1">
                    <dt class="w-20 shrink-0 font-bold text-cocoa/50">Haki</dt>
                    <dd class="text-cocoa/80">{hakiLine(g.id)}</dd>
                  </div>
                  <div class="flex gap-2 py-1">
                    <dt class="w-20 shrink-0 font-bold text-cocoa/50">Fruit</dt>
                    <dd class="text-cocoa/80">{fruitLine(g.id)}</dd>
                  </div>
                  <div class="flex gap-2 py-1">
                    <dt class="w-20 shrink-0 font-bold text-cocoa/50">Weapon</dt>
                    <dd class="text-cocoa/80">{weaponOf(g.id)}</dd>
                  </div>
                </dl>
                <details class="border-t-[3px] border-t-cocoa px-5 py-3">
                  <summary class="cursor-pointer font-bold">{g.qa.q}</summary>
                  <p class="mt-1.5 leading-relaxed text-cocoa/80">{g.qa.a}</p>
                </details>
              </section>
            );
          })
        }
      </div>

      {
        tiers.map((t) => {
          const members = byTier(t.key);
          return (
            <section class="mt-12">
              <div class="mb-4 flex items-baseline justify-between">
                <h2 class="font-hand text-4xl">{t.title}</h2>
                <span class="text-sm font-bold text-cocoa/60">{members.length} characters</span>
              </div>
              <p class="mb-4 max-w-2xl text-cocoa/80">{t.blurb}</p>
              <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 md:grid-cols-6">
                {members.map((m) => (
                  <div class="overflow-hidden rounded-2xl border-[3px] border-cocoa bg-white shadow-[4px_4px_0_#3a2a18]">
                    {m.imageURL && (
                      <img
                        alt={m.name}
                        class="aspect-square w-full object-cover"
                        loading="lazy"
                        src={m.imageURL}
                      />
                    )}
                    <p class="px-1 py-2 text-center font-hand text-lg leading-tight">{m.name}</p>
                  </div>
                ))}
              </div>
            </section>
          );
        })
      }

      <a
        class="mt-12 inline-block rounded-2xl border-4 border-cocoa bg-coral px-8 py-4 text-xl font-bold text-white shadow-[6px_6px_0_#3a2a18] active:translate-x-1 active:translate-y-1 active:shadow-none"
        href="/one-piece/draft#play"
      >
        ⚓ Draft them yourself
      </a>
    </main>
  </div>
</Layout>
