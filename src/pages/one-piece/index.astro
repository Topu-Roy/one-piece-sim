---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../../components/NavBar.svelte";
import { Characters } from "../../games/one-piece-draft/data/characters-v2";
import { calculateCharacterBST } from "../../games/one-piece-draft/lib/draft";

// Franchise hub: all One Piece games, rankings teaser, lore FAQ.
// Feeds /one-piece/draft via exact-anchor CTAs.
const top5 = [...Characters]
  .map((c) => ({ id: c.id, name: c.displayName, imageURL: c.imageURL, bst: calculateCharacterBST(c) }))
  .sort((a, b) => b.bst - a.bst)
  .slice(0, 5);

const faqs = [
  {
    q: "Does Blackbeard have Conqueror's Haki?",
    a: "Never demonstrated in the manga or anime, and unconfirmed on his Vivre Card — he fights Yonko-tier on two Devil Fruits and elite Armament instead. Try drafting his Yami Yami no Mi in the draft game and see how far fruit power alone takes a build.",
  },
  {
    q: "Does Garp have Conqueror's Haki?",
    a: "Yes — confirmed, and our data rates it among the strongest in the series. Garp is one of the best Conqueror's donors you can pull in round 4.",
  },
  {
    q: "What is Imu's Devil Fruit?",
    a: "Still unnamed in canon — a grimoire-like power granting covenants, regeneration and abyss summons. In our 184-character rankings Imu sits #1, clear of Joy Boy.",
  },
  {
    q: "Imu vs Joy Boy — who would win?",
    a: "By our feat-graded stat model: Imu takes it. Joy Boy's Nika Mythical Zoan keeps this imu vs joy boy debate the closest matchup at the top of the list — see the full rankings.",
  },
  {
    q: "Does Zoro have Conqueror's Haki?",
    a: "Yes — advanced Conqueror's, unlocked against King in Wano. Zoro is a premium round-4 donor and a top weapon pull with Enma-class blades.",
  },
  {
    q: "Does Koby have Conqueror's Haki?",
    a: "Unconfirmed — Honesty Impact showed black-lightning effects, but neither the manga nor his Vivre Card confirms it. Our data lists Koby without a Conqueror's tier, so don't bank a round-4 pick on him.",
  },
  {
    q: "Who is the strongest One Piece character?",
    a: "By our feat-graded model: Imu, clear of Joy Boy. Yonko cluster below — Kaido, Luffy, Shanks — then Roger, Dragon and Whitebeard. See the full 184-character rankings for every score.",
  },
  {
    q: "What is the best Devil Fruit to draft?",
    a: "The Nika Mythical Zoan (Luffy, Joy Boy) — the highest-scoring fruit in our data across attack, speed and stamina. Logias like Enel's lightning and Akainu's magma follow for pure output, but Nika's all-round numbers win drafts.",
  },
];
---

<Layout
  canonicalPath="/one-piece"
  description="Free One Piece games: play the One Piece draft game — build your own pirate from 184 characters — plus rankings, Straw Hats and haki answers."
  title="One Piece Games — Free Minigames | Anime Draft"
>
  <NavBar showRestart={false} />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does Blackbeard have Conqueror's Haki?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never demonstrated in the manga or anime, and unconfirmed on his Vivre Card — he fights Yonko-tier on two Devil Fruits and elite Armament instead."
          }
        },
        {
          "@type": "Question",
          "name": "Does Garp have Conqueror's Haki?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — confirmed, and our data rates it among the strongest in the series."
          }
        },
        {
          "@type": "Question",
          "name": "What is Imu's Devil Fruit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Still unnamed in canon — a grimoire-like power granting covenants, regeneration and abyss summons. In our rankings Imu sits #1."
          }
        },
        {
          "@type": "Question",
          "name": "Imu vs Joy Boy — who would win?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By our feat-graded stat model: Imu takes it."
          }
        },
        {
          "@type": "Question",
          "name": "Does Zoro have Conqueror's Haki?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — advanced Conqueror's, unlocked against King in Wano."
          }
        },
        {
          "@type": "Question",
          "name": "Does Koby have Conqueror's Haki?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unconfirmed — neither the manga nor his Vivre Card confirms it."
          }
        },
        {
          "@type": "Question",
          "name": "Who is the strongest One Piece character?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By our feat-graded model: Imu, clear of Joy Boy."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best Devil Fruit to draft?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Nika Mythical Zoan — the highest-scoring fruit in our data."
          }
        }
      ]
    }
  </script>

  <div class="bg-paper text-cocoa">
    <main class="mx-auto w-full max-w-5xl px-6">
      <!-- Hero: banner pill, Peralta H1, sticker button pair. -->
      <section class="py-14 text-center md:py-20">
        <p
          class="inline-block -rotate-2 rounded-lg border-[3px] border-coral bg-white px-4 py-1 text-sm font-bold tracking-[0.2em] text-coral uppercase"
        >
          ★ Free One Piece games ★
        </p>
        <h1 class="mx-auto mt-6 max-w-2xl font-hand text-6xl leading-[1.05]">One Piece Games</h1>
        <p class="mx-auto mt-4 max-w-xl text-lg">
          The best One Piece game collection in yer browser — free One Piece mini games, no download. Start with
          the draft game: build your own pirate from 184 characters and rank him against the full roster.
        </p>
      </section>

      <!-- Game list: live forest card + locked future cards. -->
      <section class="mb-12">
        <h2 class="text-center font-hand text-4xl">Pick yer game mode</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <!-- Draft card: W3 sideways + WANTED stamp overlap. -->
          <a
            class="flex rotate-[-0.5deg] items-stretch gap-4 rounded-3xl border-4 border-cocoa bg-white p-4 shadow-[8px_8px_0_#3a2a18] active:translate-x-1 active:translate-y-1 active:shadow-none"
            href="/one-piece/draft"
          >
            <div class="relative w-2/5 shrink-0 overflow-hidden rounded-2xl border-[3px] border-cocoa">
              <img
                alt={top5[0].name}
                class="absolute inset-0 h-full w-full object-cover object-top"
                loading="lazy"
                src={top5[0].imageURL}
              />
              <p
                class="absolute top-2 -right-2 rotate-12 rounded-lg border-[3px] border-cocoa bg-coral px-3 py-1 font-hand text-lg tracking-widest text-white"
              >
                WANTED
              </p>
            </div>
            <div class="flex min-w-0 flex-col justify-center py-1">
              <p class="text-[11px] font-bold tracking-[0.3em] text-cocoa/60 uppercase">Dead or alive</p>
              <h3 class="mt-1 font-hand text-2xl leading-[1.05] text-cocoa">Create the Strongest Character</h3>
              <span
                class="mt-3 inline-block w-fit rounded-2xl border-[3px] border-cocoa bg-coral px-6 py-2 text-base font-bold text-white shadow-[4px_4px_0_#3a2a18]"
              >
                Play →
              </span>
            </div>
          </a>
          <div class="flex flex-col justify-center rounded-3xl border-4 border-cocoa bg-white p-6 opacity-70">
            <p class="text-xs font-bold tracking-[0.16px] text-cocoa/50 uppercase">Soon</p>
            <h3 class="mt-2 font-hand text-3xl">Guess the Devil Fruit</h3>
            <p class="mt-2 text-sm">Name the fruit from hints. Daily challenge.</p>
          </div>
          <div
            class="flex rotate-[0.5deg] flex-col justify-center rounded-3xl border-4 border-cocoa bg-white p-6 opacity-70"
          >
            <p class="text-xs font-bold tracking-[0.16px] text-cocoa/50 uppercase">Soon</p>
            <h3 class="mt-2 font-hand text-3xl">Haki Quiz</h3>
            <p class="mt-2 text-sm">Who holds what? Armament to Conqueror's.</p>
          </div>
        </div>
      </section>

      <!-- Characters: face cards, no ranks — full list lives on characters. -->
      <section class="mb-12">
        <div class="mb-4 flex items-baseline justify-between">
          <h2 class="font-hand text-4xl">Characters</h2>
          <a class="text-sm font-bold text-coral underline" href="/one-piece/draft/characters">
            All 184 characters
          </a>
        </div>
        <p class="mb-4 max-w-2xl">
          Five faces from the very top of the roster — tap any card to browse all 184 characters by tier.
        </p>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
          {
            top5.map((c) => (
              <a
                class="overflow-hidden rounded-2xl border-[3px] border-cocoa bg-white shadow-[4px_4px_0_#3a2a18] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
                href="/one-piece/draft/characters"
              >
                <img alt={c.name} class="aspect-square w-full object-cover" loading="lazy" src={c.imageURL} />
                <p class="px-2 py-2 text-center font-hand text-xl leading-tight">{c.name}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="mx-auto mb-12 max-w-3xl">
        <h2 class="text-center font-hand text-4xl">What can ye draft?</h2>
        <div class="mt-6 flex flex-col gap-4 leading-relaxed">
          <p>
            All 184 roster characters are draftable, from god-tier monsters like Imu and Joy Boy down to loveable
            weaklings like Buggy and Momonosuke. Bodies come in every race — human, fish-man, giant, mink, lunarian
            and more — each hand-graded from canon feats, never from a race table. Haki donors span all three
            colors and four tiers, Devil Fruits cover every type from Logia to Mythical Zoan, and weapons run from
            Enma-class greatswords to Usopp's slingshot.
          </p>
          <p>
            Rarity shapes every round: basic donors are common, epics show up often, legends define drafts, and
            gods appear rarely enough to feel like treasure. The full
            <a class="font-bold text-coral underline" href="/one-piece/draft/characters">Straw Hats</a>
            break down ten famous donors stat by stat — start there if the roster feels big.
          </p>
        </div>
      </section>

      <section class="mx-auto mb-12 max-w-3xl">
        <h2 class="text-center font-hand text-4xl">How the draft game plays</h2>
        <div class="mt-6 flex flex-col gap-4 leading-relaxed">
          <p>
            You draft across eight rounds with four donors each. Round one sets the body — looks, name and base
            stats. Rounds two to four harvest Armament, Observation and Conqueror's Haki, with at least two real
            holders guaranteed every round. Round five is Devil Fruit users only, round six is weapons with three
            users guaranteed, and rounds seven and eight draft intelligence and battle IQ as percentage bonuses.
            Two rerolls cover the whole draft, usable anywhere including the final round.
          </p>
          <p>
            When the eighth pick locks, the game scores your 7-stat build with the same feat-graded model as all
            184 roster characters and deals a live rank out of 185. Full rules live on the
            <a class="font-bold text-coral underline" href="/one-piece/draft/how-to-play">how to play page</a> — this
            is the short version that gets you drafting in a minute.
          </p>
        </div>
      </section>

      <section class="mx-auto mb-12 max-w-3xl">
        <h2 class="text-center font-hand text-4xl">Why this one hooks ye</h2>
        <div class="mt-6 flex flex-col gap-4 leading-relaxed">
          <p>
            Most One Piece games ask what you remember. The draft game asks what you understand: which haki type
            carries attack, why a Mythical Zoan beats raw muscle, when to burn a reroll on a Devil Fruit round.
            Every pick is a powerscaling decision, and the final rank grades your understanding against 184
            canon-graded characters.
          </p>
          <p>
            No two drafts play alike. Rarity rolls, guarantee backfills and your own reroll timing mean the same
            player never builds the same pirate twice — yet the scoring never moves, so ranks stay honest across
            hundreds of runs. Five minutes a draft, free forever, no account standing between you and the
            leaderboard in yer head.
          </p>
          <p>
            It also settles arguments no quiz can. Pull your crew's powers into one build and the model prices
            them: is Zoro's swordsmanship worth more than Sanji's speed, does Nika outscore magma, can a giant's
            body carry weak haki? Every One Piece debate becomes a draft — and the rank at the end is the receipt.
          </p>
        </div>
      </section>

      <section class="mx-auto mb-12 max-w-3xl">
        <h2 class="text-center font-hand text-4xl">Is this canon?</h2>
        <div class="mt-6 flex flex-col gap-4 leading-relaxed">
          <p>
            The game is an unofficial fan project — but every number in it is graded from canon. Base stats follow
            manga and anime feats, Devil Fruits track confirmed users and awakenings, haki tiers respect what's
            demonstrated on the page (unconfirmed powers, like Blackbeard's Conqueror's, stay unconfirmed in our
            data). When the story moves, the audit files move with it.
          </p>
          <p>
            Think of the roster as a playable powerscaling consensus: the same debates fans have about Imu, Joy Boy
            and the Yonko, settled into numbers you can draft with. Disagree with a grade? Good — that's what the
            draft is for. Build the version you believe in and see where it ranks.
          </p>
        </div>
      </section>

      <!-- Lore FAQ at the bottom: the P3 net. -->
      <section class="mx-auto mb-12 max-w-3xl">
        <h2 class="text-center font-hand text-4xl">One Piece powers, answered</h2>
        <div class="mt-6 flex flex-col gap-4">
          {
            faqs.map((f) => (
              <details class="rounded-2xl border-[3px] border-cocoa bg-white px-5 py-4 shadow-[4px_4px_0_#3a2a18]">
                <summary class="cursor-pointer text-lg font-bold">{f.q}</summary>
                <p class="mt-2 leading-relaxed text-cocoa/80">{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <!-- Spokes. -->
      <section class="mb-16 flex flex-wrap justify-center gap-3">
        <a
          class="rounded-full border-[3px] border-cocoa bg-white px-4 py-2 text-sm font-bold"
          href="/one-piece/draft/how-to-play"
        >
          How to play
        </a>
        <a
          class="rounded-full border-[3px] border-cocoa bg-white px-4 py-2 text-sm font-bold"
          href="/one-piece/draft/characters"
        >
          Characters
        </a>
      </section>
    </main>
  </div>
</Layout>
